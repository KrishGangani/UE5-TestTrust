# P03_TestTrust repository: docs + the UE project in TestTrust/.
# Generated by Unreal / Visual Studio. Never commit.
TestTrust/Binaries/
TestTrust/Intermediate/
TestTrust/Saved/
TestTrust/DerivedDataCache/
TestTrust/Build/
TestTrust/Plugins/*/Binaries/
TestTrust/Plugins/*/Intermediate/
TestTrust/.vs/
TestTrust/*.sln
TestTrust/*.slnx
*.VC.db
*.opensdf
*.sdf
*.suo

# Python
__pycache__/

# Packaged builds stay out of git.
Build/

# Benchmarks: raw captures, run reports and logs stay local (too large for git; UE logs also hold
# machine-specific paths). Manifests and Summaries/ are committed; cited raw batches go to GitHub Releases.
Benchmarks/Raw/*
!Benchmarks/Raw/*_manifest.json
Benchmarks/*_console.txt

# Mutation-runner and probe snapshots of target projects (build products, never committed).
Tools/_work/

# Parked work in progress (code waiting for its step); never committed (portfolio brief, rule 11).
_wip/
